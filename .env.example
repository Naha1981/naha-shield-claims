# GEMINI_API_KEY: Required for server-side Gemini AI regulatory grounding and forensic timeline drafts.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g., Render Managed Postgres).
# When unset in preview/dev, NahaShield uses its local persistent relational store with synthetic seed data.
DATABASE_URL=

# NAHASHIELD_REGION: Target deployment region (production requires SA data residency under POPIA).
NAHASHIELD_REGION="af-south-1"

# NAHASHIELD_ORG_ID: Single-tenant insurer scope identifier.
NAHASHIELD_ORG_ID="org_sa_partner_01"
